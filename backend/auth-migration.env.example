# PUBLIC TEMPLATE ONLY. Copy to ignored .env.auth-migration AFTER approval.
# Export these MYSQL_* keys and explicitly pass -e KEY to the checks container.
# An Alembic -x env_file alone is unsafe: Compose MYSQL_* environment wins.
# This template does not authorize or execute any migration.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=recruitment_auth_test
MYSQL_USER=auth_test_migrator
MYSQL_PASSWORD=CHANGE_ME_GENERATE_AFTER_APPROVAL
