# Add these variables to the EXISTING root .env; preserve database/JWT secrets.
# Credentials must stay local. Use your provider's SMTP app password when required.
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Optional address owned by you for an explicitly requested real delivery test.
SMTP_TEST_EMAIL=
